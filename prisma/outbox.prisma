/// Durable integration intent; deliver outside the domain transaction.
model OutboxMessage {
  id               String    @id @default(uuid()) @db.Uuid
  topic            String    @db.VarChar(128)
  aggregateType    String    @map("aggregate_type") @db.VarChar(128)
  aggregateId      String    @map("aggregate_id") @db.VarChar(128)
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(256)
  payload          Json
  availableAt      DateTime  @default(now()) @map("available_at")
  claimedAt        DateTime? @map("claimed_at")
  claimExpiresAt   DateTime? @map("claim_expires_at")
  claimToken       String?   @unique @map("claim_token") @db.Uuid
  completedAt      DateTime? @map("completed_at")
  completionReason String?   @map("completion_reason") @db.VarChar(128)
  attemptCount     Int       @default(0) @map("attempt_count")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([topic, completedAt, availableAt, id])
  @@index([claimExpiresAt])
  @@map("outbox_messages")
}
